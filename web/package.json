    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
        "@types/d3-scale": "4.0.9",
        "@types/d3-scale-chromatic": "3.1.0",
        "@types/d3-shape": "3.2.0",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "typescript": "5.9.3",
        "vite": "8.3.5"
    }
