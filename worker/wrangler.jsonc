{
    // One Worker serves the built web app (web/dist) as static assets and the /v1 JSON API
    // from D1. Only /v1/* runs Worker code; every other path is a static file, or index.html.
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "ipma-mais",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-20",
    "assets": {
        "directory": "../web/dist",
        // The app's pages (/consultas, /sobre…) are routes in the app: answer them with index.html.
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/v1", "/v1/*"]
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "ipma-mais",
            // Replaced by the Cloudflare workflow with the real id; any value works locally.
            "database_id": "00000000-0000-0000-0000-000000000000",
            "migrations_dir": "migrations"
        }
    ],
    // Per-IP limit on /v1 (only /v1 runs Worker code). Keep in sync with RATE_LIMIT in src/index.ts.
    "ratelimits": [
        {
            "name": "RATE_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 600, "period": 60 }
        }
    ],
    "observability": { "enabled": true }
}
