{
    // One Worker serves the built web app (web/dist) and the /v1 JSON API from D1. Built files
    // under /assets/ (and the favicon) are served directly; every other address runs the Worker,
    // which answers the app's pages with their own title, description and text (src/pages.ts),
    // serves /sitemap.xml and /robots.txt, and falls back to the static files.
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "ipma-mais",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-20",
    "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        // Unknown addresses are answered by the Worker (the app with a 404 status), not index.html.
        "not_found_handling": "none",
        "run_worker_first": ["/*", "!/assets/*", "!/favicon.svg"]
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "ipma-mais",
            // Replaced by the Cloudflare workflow with the real id; any value works locally.
            "database_id": "00000000-0000-0000-0000-000000000000",
            "migrations_dir": "migrations"
        }
    ],
    // Per-IP limit on the /v1 API (pages are not limited). Keep in sync with RATE_LIMIT in src/index.ts.
    "ratelimits": [
        {
            "name": "RATE_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 600, "period": 60 }
        }
    ],
    "observability": { "enabled": true }
}
